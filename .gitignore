# Pipeline run outputs — results dir is literally named "tracefix.pipeline"
# (note the dot); the real package is tracefix/pipeline. Never commit run artifacts.
tracefix.pipeline/
# Dedicated workspace for ALL tracefix outputs: verified spec artifacts
# (ir.json, Protocol.tla, states.json, prompts) AND runtime domain artifacts.
# `tla-verify-pluscal init <name>` creates workspace/<name>; the sdk_adapter
# runtime writes agent file output here (its cwd). Never commit generated artifacts.
workspace/
# Re-running a committed example writes fresh agent output to its output/ dir;
# keep those run artifacts out of git (committed sample runs live in sample_run/).
tracefix/runtime/sdk_adapter/examples/*/output/
