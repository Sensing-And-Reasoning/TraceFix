# TraceFix environment — copy to `.env` and fill in the keys you need.
#   cp .env.example .env
# `.env` is gitignored; it is auto-loaded from the repo root at runtime.
#
# Which commands need keys?
#   • Design + verify  (tla-verify-pluscal validate/scaffold/verify/extract-states)
#       → NO API key required. Works fully offline with hand-written specs.
#   • Agentic pipeline (python -m tracefix.pipeline ...)
#       → needs OPENAI_API_KEY or ANTHROPIC_API_KEY (per --provider).
#   • Runtimes         (python -m tracefix.runtime.* ...)
#       → same API keys as the pipeline.

# LLM provider keys (set the one(s) matching your --provider)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# --- Optional: override the verification toolchain location ---
# Only needed if `tla-verify-pluscal doctor` can't find Java 17 or the jar.
# TLA_VERIFY_JAVA=/path/to/java17/bin/java
# TLA_VERIFY_JAR=/path/to/tla2tools.jar
